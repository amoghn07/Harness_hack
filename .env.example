# RepoHealth configuration — copy to .env and fill in.
#
#   cp .env.example .env
#
# .env is gitignored. EVERYTHING here is optional: with nothing set, the project
# runs on the zero-dependency mock backends (mock GitHub + SQLite + mock
# inference). Set a backend selector to "real" and fill its credentials to flip
# that piece to production.

# ── Backend selectors ───────────────────────────────────────────────────────
REPOHEALTH_GITHUB=mock          # mock | composio   (composio needs COMPOSIO_API_KEY)
REPOHEALTH_STORE=sqlite         # sqlite | clickhouse (clickhouse needs CLICKHOUSE_*)
REPOHEALTH_REGISTRY=mock        # mock | http        (http hits npm/PyPI, no key)
REPOHEALTH_INFERENCE=mock       # mock | bedrock     (bedrock needs AWS_* below)
REPOHEALTH_ACTIONS=mock         # mock | composio   (Phase 3: PRs/issues/report)

# ── Phase 2 scoring ─────────────────────────────────────────────────────────
# Health score (0-100) below which the cycle escalates to Bedrock. At/above it,
# inference is skipped so healthy repos cost ~nothing.
REPOHEALTH_SCORE_THRESHOLD=60

# ── Composio (Phase 1/3: live GitHub) ───────────────────────────────────────
# Get a key at https://app.composio.dev → Settings → API Keys.
COMPOSIO_API_KEY=
COMPOSIO_USER_ID=repohealth     # identifies the connected GitHub account
COMPOSIO_AUTH_CONFIG_ID=        # optional; auto-created on first `connect` if blank

# ── ClickHouse (Phase 1: production memory) ─────────────────────────────────
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=repohealth

# ── AWS Bedrock (Phase 2: remediation inference via the Converse API) ───────
# Credentials resolve via the standard AWS chain; these env vars take precedence.
# Calls go through Bedrock's provider-agnostic Converse API, so any Converse-
# capable model works by id. The default (Amazon Nova Pro) is generally
# available with no use-case form. Anthropic/Claude models require submitting
# the provider's use-case form in the console and often a region-prefixed
# inference-profile id (e.g. us.anthropic.claude-opus-4-8). The model must be
# enabled in your region (Console → Bedrock → Model access).
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=              # only for temporary STS credentials
# A long-term Bedrock API key (ABSK… bearer token) is an alternative to the
# access-key/secret pair above — botocore signs Converse calls with it.
AWS_BEARER_TOKEN_BEDROCK=
BEDROCK_MODEL_ID=amazon.nova-pro-v1:0

# ── Phase 3: act & publish (weekly report destination) ─────────────────────
# The bump PRs and stale-issue closes use the same connected GitHub account as
# the connector (COMPOSIO_API_KEY above). These configure where the weekly
# report is posted.
REPOHEALTH_REPORT_TARGET=github  # github | notion
REPOHEALTH_REPORT_REPO=          # owner/name to post to; blank = the monitored repo
GITHUB_DISCUSSION_CATEGORY=      # category id for GITHUB_CREATE_A_DISCUSSION
# Only when REPOHEALTH_REPORT_TARGET=notion:
NOTION_API_KEY=
NOTION_PARENT_PAGE_ID=

# ── SQLite (mock store) ─────────────────────────────────────────────────────
REPOHEALTH_SQLITE_PATH=data/repohealth.db
